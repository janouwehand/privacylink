# Merge these site blocks into the existing Caddy configuration after checking
# that the host ports match the environment files on the VPS.

plstaging.softable.nl {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8081
}


privacylink.nl {
	encode zstd gzip
	reverse_proxy 127.0.0.1:8080
}

privacylink.eu {
	redir https://privacylink.nl{uri} permanent
}

