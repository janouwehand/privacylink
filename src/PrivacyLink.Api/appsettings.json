{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost;127.0.0.1;[::1]",
  "Limits": {
    "MaxMessagePlaintextBytes": 80000,
    "MaxRequestBytes": 37748736,
    "MaxFiles": 10,
    "MaxTotalPlaintextFileBytes": 26214400,
    "AllowedFileExtensions": [
      ".pdf", ".txt", ".md", ".rtf", ".csv", ".tsv", ".json", ".xml", ".yaml", ".yml",
      ".docx", ".xlsx", ".pptx", ".odt", ".ods", ".odp", ".jpg", ".jpeg", ".png", ".gif",
      ".webp", ".bmp", ".tif", ".tiff",
      ".7z", ".zip", ".rar", ".tar", ".gz", ".tgz", ".bz2", ".xz", ".zst",
      ".cer", ".crt", ".der", ".pem", ".p7b", ".p7c", ".p12", ".pfx", ".key"
    ]
  },
  "RateLimiting": {
    "CreatePerIpPerHour": 20,
    "CreatePerIpPerDay": 100,
    "OpenPerIpPerMinute": 30,
    "UnlockPerIpPerMinute": 5,
    "UnlockPerIpPerHour": 20,
    "RevokePerIpPerMinute": 5,
    "RevokePerIpPerHour": 20
  },
  "Security": {
    "SecretStore": {
      "Provider": "Environment"
    },
    "EnableHsts": true,
    "RequireHttps": true,
    "RequirePasswordPepper": true,
    "TrustedProxies": [],
    "MinPasswordLength": 4,
    "MaxPasswordLength": 256,
    "UnlockAttempts": {
      "MaxPerWindow": 5,
      "WindowMinutes": 15,
      "CooldownMinutes": 15
    },
    "Argon2": {
      "MemorySizeKb": 65536,
      "Iterations": 3,
      "DegreeOfParallelism": 2,
      "MaxConcurrentOperations": 2,
      "MaxQueuedUnlocks": 8,
      "UnlockQueueTimeoutSeconds": 30
    }
  },
  "Storage": {
    "MaxActiveSecrets": 10000,
    "MaxCiphertextBytes": 268435456,
    "BlobPath": "data/blobs",
    "CleanupIntervalMinutes": 15,
    "CleanupBatchSize": 100
  }
}
