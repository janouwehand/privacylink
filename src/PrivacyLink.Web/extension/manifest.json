{
  "manifest_version": 3,
  "name": "PrivacyLink",
  "description": "Create and open encrypted secrets with the locally installed PrivacyLink client.",
  "version": "0.1.0",
  "permissions": ["clipboardWrite"],
  "host_permissions": ["https://privacylink.nl/*"],
  "content_scripts": [
    {
      "matches": ["https://privacylink.nl/s/*"],
      "js": ["recipient-content.js"],
      "run_at": "document_start",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Create a PrivacyLink secret",
    "default_popup": "index.html"
  }
}
