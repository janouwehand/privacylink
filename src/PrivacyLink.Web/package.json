{
  "name": "privacy-link-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve privacy-link-web --proxy-config proxy.conf.json",
    "build": "ng build privacy-link-web",
    "build:extension": "ng build privacy-link-extension && npm run bundle:extension-recipient",
    "bundle:extension-recipient": "esbuild extension/src/recipient-main.ts --bundle --format=iife --target=chrome120 --outfile=dist/privacy-link-extension/browser/recipient-content.js",
    "verify:extension": "node ../../scripts/verify-extension-package.mjs",
    "build:container": "powershell -NoProfile -File ../../scripts/build-web-container.ps1",
    "watch": "ng build privacy-link-web --watch --configuration development",
    "test": "ng test privacy-link-web --watch=false && node ../../scripts/extension-manifest.test.mjs"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/router": "^22.2.1",
    "hash-wasm": "^4.12.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.1",
    "@angular/cli": "^22.2.4",
    "@angular/compiler-cli": "^22.2.1",
    "esbuild": "^0.28.2",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "vite": "^8.3.3"
  }
}
