# Replace these with independent, long random values. Compose mounts them as
# secrets; the values are not passed to the containers as environment variables.
POSTGRES_PASSWORD=replace-with-a-long-random-password
PRIVACYLINK_PASSWORD_PEPPER=replace-with-a-different-long-random-secret
PRIVACYLINK_AUDIT_HASH_KEY=generate-a-unique-32-byte-base64-key
PRIVACYLINK_ANALYTICS_KEY=generate-a-unique-32-byte-base64-key
PRIVACYLINK_ALLOWED_HOSTS=localhost
# Compose uses HTTP behind a local/Caddy reverse proxy. Set true to enforce HTTPS in the app.
PRIVACYLINK_REQUIRE_HTTPS=false
PRIVACYLINK_HTTP_PORT=8080
PRIVACYLINK_BIND_ADDRESS=127.0.0.1
PRIVACYLINK_IMAGE=privacylinkslim:local
PRIVACYLINK_PULL_POLICY=build
# Optional: exact IP of the reverse proxy as observed by the API container.
# PRIVACYLINK_TRUSTED_PROXY_0=172.20.0.1

# To keep data from an older Compose setup, use its existing volume names:
# PRIVACYLINK_POSTGRES_VOLUME=privacylink-postgres-data
# PRIVACYLINK_BLOBS_VOLUME=privacylink-blobs
